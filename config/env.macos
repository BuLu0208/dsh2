DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=http://127.0.0.1:1/disabled/
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=http://127.0.0.1:1/disabled
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=http://127.0.0.1:1/disabled
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["http://127.0.0.1:1"]}
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
