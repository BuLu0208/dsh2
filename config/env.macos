# dsh2 本地未签名构建配置（--unsigned 不需要签名/公证凭据）
# origin 必须是 https 裸源：无凭据、无 path、无 query、无 fragment
DSH_DESKTOP_APP_ID=com.buluo.dsh2
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://dsh2.invalid/
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://dsh2.invalid
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://dsh2.invalid
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://dsh2.invalid"],"allowedPageOrigins":["https://dsh2.invalid"]}
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
